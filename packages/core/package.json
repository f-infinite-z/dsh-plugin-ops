{
  "name": "dsh-plugin-ops-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared engine for dsh-plugin-ops: profile readers, scan rules, report model, fix planner",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf lib"
  }
}
