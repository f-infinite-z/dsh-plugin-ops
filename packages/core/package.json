{
  "name": "dsh-plugin-ops-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared engine for dsh-plugin-ops: profile readers, scan rules, report model, fix planner",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \u0022require(\u0027fs\u0027).rmSync(\u0027lib\u0027,{recursive:true,force:true})\u0022"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.0.1-rc.3",
    "@pnpm/lockfile-file": "^9.1.3",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
